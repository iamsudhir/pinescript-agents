# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=
# Optional: NSE price data (years of intraday instead of yfinance's 30-60 days). Values here win over
# Windows/OS environment variables.
# LAKE_ROOT: local copy of MyHFTAlgoBot's Parquet lake (5m + daily). Fill it per symbol with
#   python -m workbench lake-pull RAYMOND.NS ^NSEI      (copies from LAKE_REMOTE with scp)
LAKE_ROOT=lake
LAKE_REMOTE=user@your-vps:/opt/myhftalgobot/data
# Dhan API: bars newer than the lake, symbols not pulled, and 3m (built from 1m). Needs the Data API plan.
# Get both at web.dhan.co -> My Profile -> Access DhanHQ APIs. The token expires: paste a new one here.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional: model for generation and analysis (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional: database file (default workbench.db in this folder)
# WORKBENCH_DB=
# Optional: 1 = never call Claude; generation returns a fixed EMA-cross example
# WORKBENCH_DRY_RUN=1
